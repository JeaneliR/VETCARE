# Entorno dedicado para correr `npm test`. Usa una base de datos distinta
# a la de desarrollo (vetcare_test en vez de vetcare) para que las pruebas
# de integración/seguridad nunca toquen tus datos de demo/desarrollo.
#
# Antes de correr las pruebas, crea la base y aplícale las migraciones:
#   createdb -U vetcare vetcare_test        (o: psql -U vetcare -c "CREATE DATABASE vetcare_test"
#   DATABASE_URL=postgresql://vetcare:vetcare-local@localhost:5432/vetcare_test npx prisma migrate deploy
#   DATABASE_URL=postgresql://vetcare:vetcare-local@localhost:5432/vetcare_test npm run seed
#
# Ajusta usuario/contraseña/puerto si tu Postgres local no usa los valores
# por defecto de docker-compose.yml.
DATABASE_URL=postgresql://vetcare:vetcare-local@localhost:5432/vetcare_test
JWT_SECRET=vetcare-test-secret-no-usar-en-produccion
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
PORT=4000

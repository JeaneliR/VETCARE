// Esquema de base de datos - VetCare Manager
// Curso: Herramienta de Desarrollo (React + TypeScript + Node/Express + Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// MODULO: Usuarios del sistema (staff de la veterinaria) y permisos
// ---------------------------------------------------------------------------
// rol (String, validado con Zod): ADMIN | STAFF
// El ADMIN tiene acceso total siempre. Un STAFF solo puede crear/editar/
// eliminar en los módulos donde tenga una fila en UserPermission; puede
// VER (GET) todos los módulos para no romper los selects de otras pantallas
// (ej. elegir una mascota al crear una cita).
model User {
  id           Int              @id @default(autoincrement())
  nombre       String
  email        String           @unique
  passwordHash String
  rol          String           @default("STAFF")
  activo       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  permisos     UserPermission[]
  sedes        UserLocation[]

  @@map("users")
}

model UserPermission {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  modulo String

  @@unique([userId, modulo])
  @@map("user_permissions")
}

// Sedes a las que queda restringido un usuario STAFF (citas y baños/cortes).
// Si un usuario no tiene ninguna fila aquí, se le trata como "todas las
// sedes" (sin restricción), para no romper cuentas ya creadas.
model UserLocation {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@map("user_locations")
}

// ---------------------------------------------------------------------------
// MODULO: Dueños (Owners)
// ---------------------------------------------------------------------------
model Owner {
  id          Int      @id @default(autoincrement())
  nombres     String
  apellidos   String
  dni         String   @unique
  telefono    String
  email       String   @unique
  direccion   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mascotas    Pet[]
  resenas     Review[]

  @@map("owners")
}

// ---------------------------------------------------------------------------
// MODULO: Mascotas (Pets)
// ---------------------------------------------------------------------------
// Nota: SQLite no soporta el tipo `enum` nativo de Prisma, así que estos
// campos se guardan como String y se validan en la API con Zod (ver
// src/schemas/pet.schema.ts). Valores válidos:
// especie: PERRO | GATO | AVE | ROEDOR | REPTIL | OTRO
// sexo: MACHO | HEMBRA
model Pet {
  id              Int      @id @default(autoincrement())
  nombre          String
  especie         String
  raza            String?
  sexo            String
  fechaNacimiento DateTime?
  peso            Float?
  color           String?
  esterilizado    Boolean  @default(false)
  notas           String?
  fotoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  duenoId         Int
  dueno           Owner    @relation(fields: [duenoId], references: [id], onDelete: Cascade)

  citas           Appointment[]
  vacunas         Vaccine[]
  tratamientos    Treatment[]
  banosCortes     Grooming[]

  @@map("pets")
}

// ---------------------------------------------------------------------------
// MODULO: Sedes / Ubicación (Locations)
// ---------------------------------------------------------------------------
model Location {
  id          Int      @id @default(autoincrement())
  nombre      String
  direccion   String
  ciudad      String
  telefono    String
  email       String?
  horario     String?
  latitud     Float?
  longitud    Float?
  imagenUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  citas       Appointment[]
  banosCortes Grooming[]
  resenas     Review[]
  usuarios    UserLocation[]

  @@map("locations")
}

// ---------------------------------------------------------------------------
// MODULO: Citas (Appointments)
// ---------------------------------------------------------------------------
// estado (String, validado con Zod): PENDIENTE | CONFIRMADA | COMPLETADA | CANCELADA
model Appointment {
  id          Int         @id @default(autoincrement())
  fecha       DateTime
  motivo      String
  veterinario String
  estado      String      @default("PENDIENTE")
  notas       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  mascotaId   Int
  mascota     Pet         @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  sedeId      Int
  sede        Location    @relation(fields: [sedeId], references: [id])

  @@map("appointments")
}

// ---------------------------------------------------------------------------
// MODULO: Vacunas (Vaccines)
// ---------------------------------------------------------------------------
model Vaccine {
  id               Int       @id @default(autoincrement())
  nombre           String
  fechaAplicacion  DateTime
  proximaDosis     DateTime?
  veterinario      String
  lote             String?
  notas            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mascotaId        Int
  mascota          Pet       @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@map("vaccines")
}

// ---------------------------------------------------------------------------
// MODULO: Tratamientos (Treatments)
// ---------------------------------------------------------------------------
// estado (String, validado con Zod): EN_CURSO | FINALIZADO | SUSPENDIDO
model Treatment {
  id            Int               @id @default(autoincrement())
  diagnostico   String
  descripcion   String
  medicamentos  String?
  fechaInicio   DateTime
  fechaFin      DateTime?
  veterinario   String
  estado        String            @default("EN_CURSO")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  mascotaId     Int
  mascota       Pet               @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@map("treatments")
}

// ---------------------------------------------------------------------------
// MODULO: Baños y Cortes (Grooming)
// ---------------------------------------------------------------------------
// tipoServicio (String, validado con Zod): BANO | CORTE | BANO_Y_CORTE | DESLANADO | CORTE_UNAS
model Grooming {
  id            Int                  @id @default(autoincrement())
  tipoServicio  String
  fecha         DateTime
  precio        Float
  encargado     String
  notas         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  mascotaId     Int
  mascota       Pet                  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  sedeId        Int
  sede          Location             @relation(fields: [sedeId], references: [id])

  @@map("grooming_services")
}

// ---------------------------------------------------------------------------
// MODULO: Reseñas (Reviews)
// ---------------------------------------------------------------------------
// Ya no es un módulo del sistema interno: solo se muestran/crean desde la
// página pública. Un cliente puede dejar su reseña sin tener cuenta ni ser
// un "Dueño" ya registrado, así que duenoId es opcional y agregamos
// nombreCliente para ese caso (se debe llenar uno de los dos).
model Review {
  id            Int      @id @default(autoincrement())
  calificacion  Int      // 1 a 5
  comentario    String
  nombreCliente String?  // usado cuando la reseña no viene de un Owner ya registrado
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())

  duenoId       Int?
  dueno         Owner?   @relation(fields: [duenoId], references: [id], onDelete: Cascade)

  sedeId        Int
  sede          Location @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
# Si corres el backend con "npm run dev" fuera de Docker, levanta una
# instancia de Postgres local (o usa "docker compose up db") y ajusta esta
# URL. Si usas docker-compose.yml para todo, ya trae su propia DATABASE_URL.
DATABASE_URL="postgresql://vetcare:vetcare-local@localhost:5432/vetcare"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Cambien esto por un valor propio antes de usar el proyecto en producción.
JWT_SECRET="vetcare-secreto-de-desarrollo-cambiar-en-produccion"
JWT_EXPIRES_IN="12h"

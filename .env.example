# Variables opcionales para `docker compose up`. Si no creas un `.env` en la
# raíz del proyecto, docker-compose.yml usa los valores por defecto que ya
# están en el propio archivo (pensados solo para desarrollo local).

# Contraseña del usuario de Postgres dentro del contenedor `db`.
POSTGRES_PASSWORD=vetcare-local

# Secreto para firmar los JWT del login. Cambiar siempre antes de un uso real.
JWT_SECRET=vetcare-secreto-de-desarrollo-cambiar-en-produccion
JWT_EXPIRES_IN=12h

# Si es "true", el backend corre `npm run seed` automáticamente al arrancar
# el contenedor (ver backend/docker-entrypoint.sh).
SEED_ON_START=false

# URL que el frontend usa para llamar a la API (se usa como build-arg de
# `frontend/Dockerfile`, así que un cambio aquí requiere reconstruir la
# imagen: `docker compose up --build frontend`).
VITE_API_URL=http://localhost:4000/api

# Credenciales del panel de Grafana (http://localhost:3001). Cambiar antes de
# dejarlo expuesto fuera de tu máquina.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
